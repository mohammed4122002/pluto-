# =============================================================================
# PLUTO — clinic template environment
# Copy this file to `.env` at the repo root and fill in real values.
# backend/, ai-services/, and (at container start) frontend/ all read this
# same file — one place to configure a whole deployment.
# =============================================================================

# --- Supabase (create a project at https://supabase.com/dashboard) ---
# Settings > API > Project URL, and the service_role secret key.
# service_role bypasses Row Level Security — backend-only, never shipped to
# the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-secret-key

# --- OpenAI (used by ai-services to generate patient replies) ---
OPENAI_API_KEY=sk-...

# --- n8n (your own instance — self-hosted or n8n Cloud) ---
# General REST API key: n8n → Settings → n8n API → Create an API Key.
# This is what lets the dashboard provision new WhatsApp/Telegram channels
# automatically (creates the credential + clones + activates the workflow).
N8N_API_BASE_URL=https://your-n8n-instance.com/api/v1
N8N_REST_API_KEY=
# Workflow ID of the reference "Clinic Telegram Bot" workflow in your n8n
# instance — new Telegram channels are cloned from this one. Leave blank
# until you've built that reference workflow once (see README).
N8N_TELEGRAM_TEMPLATE_WORKFLOW_ID=

# --- Public URLs backend/ai-services are reachable at ---
# n8n runs on its own server and cannot reach "localhost" — these must be
# real public URLs once deployed (e.g. Railway/Render, or your own domain).
BACKEND_PUBLIC_URL=http://localhost:8000
AI_SERVICE_PUBLIC_URL=http://localhost:8100

# --- Auth ---
# JWT_SECRET signs staff login tokens; ENCRYPTION_KEY encrypts MFA secrets at
# rest. Generate real values for each deployment — never reuse these across
# clinics or commit real values to git:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=change-me-generate-a-real-random-secret
ENCRYPTION_KEY=change-me-generate-a-real-fernet-key

# --- Service-to-service auth ---
# A shared secret n8n sends as `X-Service-Token` when it calls the backend
# directly (inbound message webhook, payment-receipt webhook, reminder-cron
# trigger) — these aren't staff/dashboard calls, so login doesn't apply.
# Roll out as "permissive" first (logs a warning but still allows the
# request), update your n8n workflows to send the header, confirm the
# warnings stop, then switch to "strict":
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_TOKEN=change-me-generate-a-real-random-secret
SERVICE_AUTH_MODE=permissive

# --- CORS: which origins the backend accepts browser requests from ---
# JSON array of the dashboard's URL(s), dev and/or production.
CORS_ORIGINS=["http://localhost:5173"]

# --- Frontend ---
# Where the dashboard (browser) sends its API calls. In docker-compose this
# is read at container *start* (not baked into the build) — see frontend/README.
VITE_API_BASE_URL=http://localhost:8000

# =============================================================================
# Only needed if you use Claude Code / the MCP servers in .mcp.json to manage
# this project — not required to run the app itself.
# =============================================================================
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxx
N8N_MCP_URL=https://your-n8n-instance.com/mcp-server/http
N8N_API_KEY=n8n_api_xxxxxxxxxxxxxxxxxxxx
