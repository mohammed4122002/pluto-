{
  "name": "Clinic Telegram Bot",
  "nodes": [
    {"id":"57468fd9-8035-45c9-9d22-d65c6801d96f","name":"Telegram Trigger","type":"n8n-nodes-base.telegramTrigger","typeVersion":1.5,"position":[240,300],"parameters":{"updates":["message"]}},
    {"id":"302feb75-947c-4ad9-956e-df96687566de","name":"Normalize & Config","type":"n8n-nodes-base.set","typeVersion":3.5,"position":[540,300],"parameters":{"mode":"manual","assignments":{"assignments":[{"id":"channelId","name":"channelId","value":"REPLACE_AT_CLONE_TIME","type":"string"},{"id":"external_user_id","name":"external_user_id","value":"={{ $json.message.chat.id }}","type":"string"},{"id":"display_name","name":"display_name","value":"={{ $json.message.from.first_name ?? $json.message.from.username ?? \"\" }}","type":"string"},{"id":"message_text","name":"message_text","value":"={{ $json.message.text ?? $json.message.caption ?? \"\" }}","type":"string"}]}}},
    {"id":"2d4e483a-fba5-4ef2-ae5e-d9de02f3d1a9","name":"Send To Backend Inbound","type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[840,300],"parameters":{"method":"POST","url":"https://clinic-backend-production-4ead.up.railway.app/conversations/inbound","authentication":"genericCredentialType","genericAuthType":"httpTemplatedCustomAuth","sendBody":true,"contentType":"json","specifyBody":"json","jsonBody":"={{ { \"channel_id\": $json.channelId, \"message\": $json.message_text, \"external_user_id\": $json.external_user_id, \"display_name\": $json.display_name, \"provider_type\": \"telegram\" } }}","options":{"timeout":30000}},"credentials":{"httpTemplatedCustomAuth":{"id":"REPLACE_WITH_PLUTO_SERVICE_TOKEN_CREDENTIAL_ID","name":"PLUTO Service Token"}}},
    {"id":"c7f9c737-655f-4f86-a8fe-e433a1639bea","name":"Needs AI Reply?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[1140,300],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"leftValue":"={{ $json.mode }}","operator":{"type":"string","operation":"equals"},"rightValue":"ai"}],"combinator":"and"}}},
    {"id":"b429e9a1-5faa-482e-96e3-2a2cfd62217e","name":"Generate AI Reply","type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[1440,220],"parameters":{"method":"POST","url":"https://clinic-ai-services-production.up.railway.app/chat/reply","authentication":"genericCredentialType","genericAuthType":"httpTemplatedCustomAuth","sendBody":true,"contentType":"json","specifyBody":"json","jsonBody":"={{ { \"conversation_id\": $(\"Send To Backend Inbound\").item.json.conversation_id, \"message\": $(\"Normalize & Config\").item.json.message_text } }}","options":{"timeout":30000}},"credentials":{"httpTemplatedCustomAuth":{"id":"REPLACE_WITH_PLUTO_SERVICE_TOKEN_CREDENTIAL_ID","name":"PLUTO Service Token"}}},
    {"id":"f75dfb1e-fc17-48c6-8765-7cc97fded8f0","name":"Send AI Reply","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[1740,220],"parameters":{"resource":"message","operation":"sendMessage","chatId":"={{ $(\"Normalize & Config\").item.json.external_user_id }}","text":"={{ $json.reply }}"}},
    {"id":"fcb149e1-9b29-43b5-8614-7ccfc3879da3","name":"Outbound Send Webhook","type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[240,620],"parameters":{"httpMethod":"POST","path":"REPLACE_AT_CLONE_TIME","authentication":"none","responseMode":"onReceived"}},
    {"id":"db307c99-1dc6-490e-98da-a676c534c2b9","name":"Send Outbound Message","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[540,620],"parameters":{"resource":"message","operation":"sendMessage","chatId":"={{ $json.body.recipient }}","text":"={{ $json.body.message }}"}},
    {"id":"6f7ca5dd-7e3c-48ec-9b4f-4e711e3a591c","name":"Sticky Note","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[100,300],"parameters":{"content":"## Clinic Telegram Bot (TEMPLATE — do not activate directly)\nThis is the reference workflow backend/app/core/n8n_client.py::clone_telegram_workflow() clones per Telegram channel. It rewrites two placeholders on every clone:\n- \"Normalize & Config\" assignment channelId -> the real channel UUID\n- \"Outbound Send Webhook\" path -> a unique per-channel path\n...and swaps every telegramTrigger/telegram node's credential for the channel's own bot token.\n\nSet this workflow's ID as N8N_TELEGRAM_TEMPLATE_WORKFLOW_ID in the backend env. Needs the \"PLUTO Service Token\" credential (template) wired to the two HTTP Request nodes.","color":5,"height":260,"width":460}}
  ],
  "connections": {
    "Telegram Trigger": {"main": [[{"node":"Normalize & Config","type":"main","index":0}]]},
    "Normalize & Config": {"main": [[{"node":"Send To Backend Inbound","type":"main","index":0}]]},
    "Send To Backend Inbound": {"main": [[{"node":"Needs AI Reply?","type":"main","index":0}]]},
    "Needs AI Reply?": {"main": [[{"node":"Generate AI Reply","type":"main","index":0}]]},
    "Generate AI Reply": {"main": [[{"node":"Send AI Reply","type":"main","index":0}]]},
    "Outbound Send Webhook": {"main": [[{"node":"Send Outbound Message","type":"main","index":0}]]}
  },
  "settings": {"executionOrder": "v1"},
  "tags": ["pluto", "telegram", "template"]
