    {"id":"963591d7-45d7-4653-b406-761554353f70","name":"Send WhatsApp Reply","type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[2940,260],"parameters":{"method":"POST","url":"={{ \"https://graph.facebook.com/v20.0/\" + $(\"Extract WhatsApp Message\").item.json.phone_number_id + \"/messages\" }}","authentication":"none","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"={{ \"Bearer \" + $(\"Lookup Channel By Phone Number\").item.json.credentials.access_token }}"}]},"sendBody":true,"contentType":"json","specifyBody":"json","jsonBody":"={{ { \"messaging_product\": \"whatsapp\", \"to\": $(\"Extract WhatsApp Message\").item.json.from_wa_id, \"type\": \"text\", \"text\": { \"body\": $json.reply } } }}","options":{"timeout":30000}}},
